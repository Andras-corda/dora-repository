# ===========================================
#  .gitattributes — workspace MCreator + Git LFS
# ===========================================

# --- Fins de ligne : normalisation automatique ---
* text=auto
gradlew         text eol=lf
*.sh            text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# --- Fichiers MCreator à garder en texte (JAMAIS en LFS, sinon impossible à merger) ---
*.mcreator      text
*.mod.json      text
*.json          text
*.java          text
*.gradle        text
*.properties    text
*.toml          text
*.mcmeta        text

# --- Images / textures ---
*.png           filter=lfs diff=lfs merge=lfs -text
*.jpg           filter=lfs diff=lfs merge=lfs -text
*.jpeg          filter=lfs diff=lfs merge=lfs -text
*.gif           filter=lfs diff=lfs merge=lfs -text
*.psd           filter=lfs diff=lfs merge=lfs -text
*.kra           filter=lfs diff=lfs merge=lfs -text
*.aseprite      filter=lfs diff=lfs merge=lfs -text
*.ase           filter=lfs diff=lfs merge=lfs -text

# --- Sons ---
*.ogg           filter=lfs diff=lfs merge=lfs -text
*.wav           filter=lfs diff=lfs merge=lfs -text
*.mp3           filter=lfs diff=lfs merge=lfs -text

# --- Modèles 3D / structures ---
*.bbmodel       filter=lfs diff=lfs merge=lfs -text
*.obj           filter=lfs diff=lfs merge=lfs -text
*.blend         filter=lfs diff=lfs merge=lfs -text
*.nbt           filter=lfs diff=lfs merge=lfs -text
*.schem         filter=lfs diff=lfs merge=lfs -text

# --- Le wrapper Gradle reste un fichier Git normal ---
gradle/wrapper/gradle-wrapper.jar -filter -diff -merge binary